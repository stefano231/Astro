---
// codigo server save only - momento de construccion BUILD TIME
import type { PokemonListResponses } from '../interfaces/pokemon-list.response';

import MainLayouts from '../layouts/MainLayouts.astro';
import PokemonCard from '../components/PokemonCard.astro';

const resp = await fetch('https://pokeapi.co/api/v2/pokemon');
const data = await resp.json() as PokemonListResponses;



const title = 'Pokemon Static | Home';
---

<MainLayouts title={title}>
	<h1 class="text-3xl">Listado de Pokémons</h1>
	<hr/>
<section
    aria-label="Listado de Pokémons"
    class="grid grid-cols-1 sm:grid-cols-4 md:grid-cols-5 gap-4 mt-5"
  >
    {data.results.map(({ name, url }) => <PokemonCard name={name} url={url}/>)}
  </section>
</MainLayouts>
